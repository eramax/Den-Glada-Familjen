---
import Icon from './Icon.astro';
import { langNames, otherLang } from '../i18n';
import type { Dict, Lang } from '../i18n';

interface Props {
  lang: Lang;
  t: Dict;
  href: string;
  full?: boolean;
}

const { lang, t, href, full = false } = Astro.props;
const target = otherLang(lang);
const label = langNames[target];
const short = target === 'sv' ? 'SV' : 'AR';
---

<a
  class:list={['lang-switch', { 'lang-switch--full': full }]}
  href={href}
  hreflang={target}
  lang={target}
>
  <Icon name="globe" />
  {full ? <span>{label}</span> : <><span class="lang-switch__short">{short}</span><span class="lang-switch__full">{label}</span><span class="sr-only">{t.a11y.langSwitch}</span></>}
</a>
