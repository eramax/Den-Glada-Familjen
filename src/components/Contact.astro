---
import Icon from './Icon.astro';
import { SITE } from '../data/site';
import type { Dict, Lang } from '../i18n';

interface Props {
  lang: Lang;
  t: Dict;
}

const { t } = Astro.props;
const [emailUser, emailDomain] = SITE.email.split('@');
---

<section class="section contact" id="contact">
  <div class="container contact__grid">
    <div class="contact__content" data-reveal>
      <p class="eyebrow">{t.contact.eyebrow}</p>
      <h2>{t.contact.title}</h2>
      <p class="contact__lead">{t.contact.lead}</p>

      <div class="contact__cards">
        <a class="contact-card" href={`mailto:${SITE.email}`}>
          <span class="contact-card__icon"><Icon name="mail" /></span>
          <span class="contact-card__body">
            <span class="contact-card__label">{t.contact.emailLabel}</span>
            <span class="contact-card__value" dir="ltr">{emailUser}<wbr />@{emailDomain}</span>
          </span>
        </a>

        <a class="contact-card" href={SITE.whatsappDirect} target="_blank" rel="noopener">
          <span class="contact-card__icon"><Icon name="whatsapp" /></span>
          <span class="contact-card__body">
            <span class="contact-card__label">{t.contact.whatsappLabel}</span>
            <span class="contact-card__value" dir="ltr">{SITE.phoneDisplay}</span>
          </span>
        </a>

        <a class="contact-card" href={SITE.mapsUrl} target="_blank" rel="noopener noreferrer">
          <span class="contact-card__icon"><Icon name="mapPin" /></span>
          <span class="contact-card__body">
            <span class="contact-card__label">{t.contact.locationLabel}</span>
            <span class="contact-card__value">{t.contact.location}</span>
            <span class="contact-card__note">{t.contact.locationNote}</span>
          </span>
        </a>
      </div>

    </div>

    <form
      class="contact__form"
      data-contact-form
      data-email={SITE.email}
      data-subject={t.contact.form.subject}
      data-opening={t.contact.form.opening}
      aria-labelledby="contact-form-title"
      data-reveal
      style="--delay: 100ms"
    >
      <h3 id="contact-form-title">{t.contact.form.title}</h3>

      <div class="field">
        <label for="contact-name">{t.contact.form.name}</label>
        <input
          id="contact-name"
          name="name"
          type="text"
          placeholder={t.contact.form.namePlaceholder}
          autocomplete="name"
          required
        />
      </div>

      <div class="field">
        <label for="contact-email">{t.contact.form.email}</label>
        <input
          id="contact-email"
          name="email"
          type="email"
          placeholder={t.contact.form.emailPlaceholder}
          autocomplete="email"
          dir="ltr"
          required
        />
      </div>

      <div class="field">
        <label for="contact-message">{t.contact.form.message}</label>
        <textarea
          id="contact-message"
          name="message"
          rows="3"
          placeholder={t.contact.form.messagePlaceholder}
          required
        ></textarea>
      </div>

      <button class="btn btn--primary" type="submit">
        <Icon name="send" />
        {t.contact.form.submit}
      </button>

      <p class="form-note">{t.contact.form.note}</p>
      <p class="form-status" data-form-status role="status" aria-live="polite"></p>
      <noscript>
        <p class="form-note">
          {t.join.email}: <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </p>
      </noscript>
    </form>
  </div>
</section>
