---
import Icon from './Icon.astro';
import { latestMeetings } from '../data/meetings';
import { meetingPaths } from '../i18n';
import { formatMeetingDate } from '../lib/format';
import type { Dict, Lang } from '../i18n';

interface Props {
  lang: Lang;
  t: Dict;
}

const { lang, t } = Astro.props;
const meetingPath = meetingPaths[lang];
---

<section class="section weekly" id="weekly">
  <div class="container weekly__grid">
    <div class="weekly__content" data-reveal>
      <p class="eyebrow">{t.meetingsPage.eyebrow}</p>
      <h2>{t.meetingsPage.title}</h2>
      <p class="weekly__lead">{t.meetingsPage.lead}</p>

      <div class="weekly__schedule">
        <span class="weekly__schedule-icon"><Icon name="calendar" /></span>
        <span class="weekly__schedule-copy">
          <span class="weekly__schedule-label">{t.meetingsPage.scheduleLabel}</span>
          <strong class="weekly__schedule-time"><bdi dir="ltr">{t.meetingsPage.scheduleTime}</bdi></strong>
        </span>
        <span class="weekly__schedule-note">{t.meetingsPage.scheduleNote}</span>
      </div>

      <p class="weekly__location">
        <Icon name="mapPin" />
        {t.meetingsPage.location}
      </p>

      <a class="btn btn--primary" href={meetingPath}>
        {t.meetingsPage.ctaLanding}
        <Icon name="arrowRight" class="icon--arrow" />
      </a>
    </div>

    <div class="weekly__list-wrap" data-reveal style="--delay: 120ms">
      <p class="weekly__list-label">{t.meetingsPage.latestLabel}</p>
      <div class="weekly__list">
        {latestMeetings.map((meeting) => (
          <a class="weekly__item" href={`${meetingPath}#${meeting.id}`}>
            <span class="weekly__item-top">
              <span class="weekly__date">{formatMeetingDate(meeting.date, lang)}</span>
              <span class="weekly__tag">{meeting.tag[lang]}</span>
            </span>
            <h3>{meeting.topic[lang]}</h3>
            <p>{meeting.summary[lang]}</p>
            <span class="weekly__more">
              {t.meetingsPage.detailsLabel}
              <Icon name="arrowRight" class="icon--arrow" />
            </span>
          </a>
        ))}
      </div>
      <a class="weekly__all" href={meetingPath}>
        {t.meetingsPage.allLabel}
        <Icon name="arrowRight" class="icon--arrow" />
      </a>
    </div>
  </div>
</section>
