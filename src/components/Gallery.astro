---
import { Image } from 'astro:assets';
import galleryCommunity from '../assets/images/gallery-community.jpg';
import galleryKids from '../assets/images/gallery-kids.jpg';
import galleryTrip from '../assets/images/gallery-trip.jpg';
import galleryDinner from '../assets/images/gallery-dinner.jpg';
import Icon from './Icon.astro';
import { SITE } from '../data/site';
import type { Dict, Lang } from '../i18n';

interface Props {
  lang: Lang;
  t: Dict;
}

const { t } = Astro.props;

const images = {
  community: galleryCommunity,
  kids: galleryKids,
  trip: galleryTrip,
  dinner: galleryDinner,
};

const widths = [400, 600, 800];
const sizes = '(max-width: 900px) 78vw, 25vw';
---

<section class="section gallery" id="gallery">
  <div class="container">
    <div class="section-head section-head--split" data-reveal>
      <div>
        <p class="eyebrow">{t.gallery.eyebrow}</p>
        <h2>{t.gallery.title}</h2>
        <p>{t.gallery.lead}</p>
      </div>
      <a class="btn btn--outline gallery__yt" href={SITE.youtube} target="_blank" rel="noopener noreferrer">
        <Icon name="youtube" />
        {t.gallery.youtubeCta}
        <span class="sr-only">({t.a11y.external})</span>
      </a>
    </div>

    <div class="gallery__grid" tabindex="0" role="region" aria-label={t.gallery.title}>
      {t.gallery.items.map((item, i) => (
        <figure class="gallery__item" data-reveal style={`--delay: ${i * 70}ms`}>
          <Image
            src={images[item.key]}
            alt={item.alt}
            widths={widths}
            sizes={sizes}
          />
          <figcaption>{item.caption}</figcaption>
        </figure>
      ))}
    </div>

    <div class="gallery__foot">
      <span class="gallery__note">{t.gallery.note}</span>
    </div>
  </div>
</section>
